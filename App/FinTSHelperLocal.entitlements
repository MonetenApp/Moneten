<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The entitlements of FinTSHelper.entitlements for a Release build signed to run locally (ADR 0017). -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Ad hoc signatures have no team, and library validation would refuse the libraries of the Java runtime. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
