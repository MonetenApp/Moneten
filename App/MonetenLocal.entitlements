<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The entitlements of Moneten.entitlements for a Release build signed to run locally (ADR 0017). -->
	<!-- Needed to read data from MoneyMoney through its AppleScript export. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Ad hoc signatures have no team, and library validation would refuse SQLCipher and Sparkle. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
