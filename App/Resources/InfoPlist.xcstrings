      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moneten liest Ihre Konten, Kategorien und Umsätze aus MoneyMoney, wenn Sie sie importieren. Es ändert nichts in MoneyMoney."
