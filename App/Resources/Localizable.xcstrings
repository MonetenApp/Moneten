    "%@ changed after the warning. Allow it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat sich nach der Warnung geändert. Erlauben Sie es erneut."
          }
        }
