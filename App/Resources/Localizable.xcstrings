{
  "sourceLanguage" : "en",
  "strings" : {
    "\"Apply to all transactions\" also replaces categories that you assigned by hand, and transactions that no longer match leave this category." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Auf alle Umsätze anwenden“ ersetzt auch Kategorien, die Sie von Hand zugewiesen haben, und Umsätze, die nicht mehr passen, verlassen diese Kategorie."
          }
        }
      }
    },
    "%@ (position %lld)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (Position %2$lld)"
          }
        }
      },
      "extractionState" : "manual"
    },
    "%@ added no account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat kein Konto hinzugefügt."
          }
        }
      }
    },
    "%@ asks for a captcha before the login." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verlangt vor der Anmeldung ein Captcha."
