      },
      "extractionState" : "manual"
    },
    "%@ could not be installed, and Moneten could not restore its record. Remove it and install it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte nicht installiert werden, und Moneten konnte seinen Eintrag nicht wiederherstellen. Entfernen Sie es und installieren Sie es erneut."
          }
        }
      },
      "extractionState" : "manual"
    },
    "%@ could not be installed, because Moneten cannot read its record. %@" : {
      "localizations" : {
        "de" : {
