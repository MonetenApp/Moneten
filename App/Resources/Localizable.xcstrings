            "state" : "translated",
            "value" : "Die neue Liste der Erweiterungen konnte nicht verifiziert werden."
          }
        }
      },
      "extractionState" : "manual"
    },
    "The new list of extensions has version %lld with other content than the list Moneten has." : {
      "localizations" : {
        "de" : {
