      "extractionState" : "manual"
    },
    "%@ could not be allowed. %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ konnte nicht erlaubt werden. %2$@"
