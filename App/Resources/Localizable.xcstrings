      "extractionState" : "manual"
    },
    "The new password must not be identical to the old password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das neue Passwort darf nicht mit dem alten Passwort übereinstimmen."
          }
        }
