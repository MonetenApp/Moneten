    "A backup cannot replace the open database. Choose another location." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Sicherung kann die geöffnete Datenbank nicht ersetzen. Wählen Sie einen anderen Ort."
          }
        }
      },
      "extractionState" : "manual"
    },
    "A Bankleitzahl has 8 digits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
