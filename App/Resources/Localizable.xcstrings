    "The account has been closed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Konto wurde aufgelöst"
          }
        }
      }
    },
    "The account has been marked as closed in the account settings. The app inserted this transaction to bring the balance to zero. Change it with “Edit Transaction...” if needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Konto wurde in den Kontoeinstellungen als aufgelöst markiert. Die App hat diesen Umsatz eingefügt, um den Kontostand auf null zu bringen. Ändern Sie ihn bei Bedarf mit „Umsatz bearbeiten...“."
          }
        }
      }
    },
