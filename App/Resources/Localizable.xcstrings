    "M" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M"
          }
        }
      }
    },
    "macOS blocks the notifications of Moneten. Allow them in System Settings, Notifications, Moneten." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS blockiert die Mitteilungen von Moneten. Erlauben Sie sie in den Systemeinstellungen unter „Mitteilungen“, „Moneten“."
          }
        }
      }
    },
    "macOS did not keep this change. The setting shows the value that applies." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat diese Änderung nicht übernommen. Die Einstellung zeigt den Wert, der gilt."
          }
        }
      }
    },
    "macOS does not allow Moneten to read data from MoneyMoney. Allow it in System Settings → Privacy & Security → Automation → Moneten, then choose \"Check again\"." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS erlaubt Moneten nicht, Daten aus MoneyMoney zu lesen. Erlauben Sie es unter Systemeinstellungen → Datenschutz & Sicherheit → Automation → Moneten und wählen Sie dann „Erneut prüfen“."
          }
        }
      },
      "extractionState" : "manual"
    },
    "macOS has locked Touch ID after too many failed attempts. Enter the database password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat Touch ID nach zu vielen Fehlversuchen gesperrt. Geben Sie das Datenbankpasswort ein."
          }
        }
      }
    },
