// Signing of the app. Without a team, Xcode signs to run locally and leaves out the hardened
// runtime, because its library validation refuses the ad hoc signed SQLCipher framework.
// To sign with your team, create App/Local.xcconfig (ignored by git) with these two lines:
//   DEVELOPMENT_TEAM = <your team ID>
//   MONETENMONETEN_HARDENED_RUNTIME = YES
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
MONETENMONETEN_HARDENED_RUNTIME = NO
#include? "Local.xcconfig"
